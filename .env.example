# Copy to .env next to docker-compose.yml and adjust it. Never commit .env.
#   cp .env.example .env

# --- Network ------------------------------------------------------------------
# Host port bound to 127.0.0.1 that Nginx proxies to. Pick one not used by your other app.
TEMPEST_HTTP_PORT=5001
# true when the app runs behind Nginx (real client IP + https scheme).
TEMPEST_BEHIND_PROXY=true

# --- Resource ceilings --------------------------------------------------------
# Measured: ~125 MB idle, ~220 MB under load, ~1 ms of CPU per page.
TEMPEST_CPUS=1.5
TEMPEST_MEMORY=768M

# --- Store --------------------------------------------------------------------
TEMPEST_STORE_NAME=TEMPEST
# Price format: es-MX ($), es-CR (₡), es-CO, es-ES (€)…
TEMPEST_STORE_CULTURE=es-MX

# --- First run only (applied when the Users table is empty) ---------------------
# On a public server use a long, unique password here BEFORE the first start.
TEMPEST_ADMIN_USERNAME=admin
TEMPEST_ADMIN_PASSWORD=cambia-esta-clave-larga
# Optional initial WhatsApp number: country code + number, digits only.
TEMPEST_WHATSAPP_NUMBER=
