@* Mirrors the ProductCard layout (media 4:3, title, description, price, action) to avoid layout shift. *@
<div class="card-skeleton" aria-hidden="true">
    <div class="skeleton card-skeleton__media"></div>
    <div class="card-skeleton__body">
        <div class="skeleton skeleton-line card-skeleton__title"></div>
        <div class="skeleton skeleton-line card-skeleton__title card-skeleton__title--short"></div>
        <div class="skeleton skeleton-line card-skeleton__text"></div>
        <div class="skeleton card-skeleton__price"></div>
        <div class="skeleton card-skeleton__button"></div>
    </div>
</div>
