@* Create a product, or edit one when Product is set. *@
@inject ISender Sender
@inject ToastService Toasts

<EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" class="product-form" novalidate>
    <DataAnnotationsValidator />
    <ServerValidator @ref="_serverValidator" />

    @if (_formError is not null)
    {
        <div class="alert alert-error" role="alert"><Icon Name="alert" /> <span>@_formError</span></div>
    }

    <div class="product-form__grid">
        <div class="form-stack">
            <div class="field">
                <label for="product-name">Nombre</label>
                <InputText id="product-name" class="input" @bind-Value="_model.Name" placeholder="Ej.: Figura Kitsune Ronin 1/7" />
                <ValidationMessage For="() => _model.Name" />
            </div>

            <div class="field">
                <label for="product-description">Descripción <span class="optional">(opcional)</span></label>
                <InputTextArea id="product-description" class="input" rows="3" @bind-Value="_model.Description"
                               placeholder="Materiales, medidas, edición…" />
                <ValidationMessage For="() => _model.Description" />
            </div>

            <div class="field-row">
                <div class="field">
                    <label for="product-price">Precio</label>
                    <InputNumber id="product-price" class="input" @bind-Value="_model.Price" step="0.01" min="0" />
                    <ValidationMessage For="() => _model.Price" />
                </div>

                <div class="field">
                    <label for="product-rarity">Rareza</label>
                    <InputSelect id="product-rarity" class="input" @bind-Value="_model.Rarity">
                        @foreach (var rarity in Enum.GetValues<Rarity>())
                        {
                            <option value="@rarity">@rarity.ToLabel()</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <label class="checkbox-field">
                <InputCheckbox @bind-Value="_model.IsActive" />
                <span>Visible en el catálogo público</span>
            </label>
        </div>

        <div class="field">
            <ProductImageInput id="product-image" @bind-Value="_model.ImageUrl" />
            <ValidationMessage For="() => _model.ImageUrl" />
        </div>
    </div>

    <div class="form-actions">
        <button type="button" class="btn btn-ghost" disabled="@_saving" @onclick="OnCancel">Cancelar</button>
        <button type="submit" class="btn btn-primary" disabled="@_saving">
            <Icon Name="check" /> @(_saving ? "Guardando…" : IsEdit ? "Guardar cambios" : "Crear producto")
        </button>
    </div>
</EditForm>

@code {
    private ProductFormModel _model = new();
    private EditContext _editContext = default!;
    private ServerValidator? _serverValidator;
    private Guid? _loadedProductId;
    private bool _initialized;
    private bool _saving;
    private string? _formError;

    /// <summary>Product to edit; <c>null</c> to create a new one.</summary>
    [Parameter]
    public AdminProductDto? Product { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private bool IsEdit => Product is not null;

    protected override void OnParametersSet()
    {
        // Rebuild the form only when the target changes, never on unrelated parent renders.
        if (_initialized && _loadedProductId == Product?.Id)
        {
            return;
        }

        _model = Product is null ? new ProductFormModel() : ProductFormModel.From(Product);
        _editContext = new EditContext(_model);
        _loadedProductId = Product?.Id;
        _initialized = true;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _formError = null;
        try
        {
            Result result = Product is null
                ? await Sender.Send(_model.ToCreateCommand())
                : await Sender.Send(_model.ToUpdateCommand(Product.Id));

            if (result.IsFailure)
            {
                var shownOnFields = _serverValidator?.Display(result.Error) == true;
                _formError = shownOnFields ? "Revisa los campos marcados." : result.Error.Message;
                return;
            }

            Toasts.Success(IsEdit ? $"«{_model.Name}» se actualizó." : $"«{_model.Name}» se agregó al catálogo.");
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }
}
