@* Feature: the signed-in admin changes their own password. The security stamp rotates, so every
   session (this one included) is closed and the admin signs in again with the new password. *@
@using System.ComponentModel.DataAnnotations
@inject ISender Sender
@inject NavigationManager Navigation

<section class="panel password-panel">
    <header class="panel__header">
        <h2 class="panel__title"><Icon Name="key" /> Cambiar mi contraseña</h2>
    </header>

    @if (_done)
    {
        <div class="alert alert-success" role="status">
            <Icon Name="check" />
            <span>Contraseña actualizada. Cerrando todas las sesiones…</span>
        </div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="ChangeAsync" class="form-stack" novalidate>
            <DataAnnotationsValidator />
            <ServerValidator @ref="_serverValidator" />

            @if (_formError is not null)
            {
                <div class="alert alert-error" role="alert"><Icon Name="alert" /> <span>@_formError</span></div>
            }

            <div class="field">
                <label for="current-password">Contraseña actual</label>
                <InputText id="current-password" type="password" class="input" @bind-Value="_model.CurrentPassword" autocomplete="current-password" />
                <ValidationMessage For="() => _model.CurrentPassword" />
            </div>

            <div class="field">
                <label for="new-password">Nueva contraseña</label>
                <InputText id="new-password" type="password" class="input" @bind-Value="_model.NewPassword" autocomplete="new-password" />
                <p class="hint">Mínimo @PasswordPolicy.MinLength caracteres. Usa una frase larga y única.</p>
                <ValidationMessage For="() => _model.NewPassword" />
            </div>

            <div class="field">
                <label for="confirm-password">Confirmar nueva contraseña</label>
                <InputText id="confirm-password" type="password" class="input" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" />
                <ValidationMessage For="() => _model.ConfirmPassword" />
            </div>

            <div class="alert alert-info">
                <Icon Name="shield" />
                <span>Al guardar se cerrarán todas tus sesiones abiertas (incluida esta) y deberás ingresar de nuevo.</span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    <Icon Name="check" /> @(_saving ? "Actualizando…" : "Actualizar contraseña")
                </button>
            </div>
        </EditForm>
    }
</section>

@code {
    private readonly PasswordFormModel _model = new();
    private ServerValidator? _serverValidator;
    private bool _saving;
    private bool _done;
    private string? _formError;

    private async Task ChangeAsync()
    {
        _saving = true;
        _formError = null;
        try
        {
            var result = await Sender.Send(new ChangePasswordCommand(_model.CurrentPassword, _model.NewPassword));
            if (result.IsFailure)
            {
                var shownOnFields = _serverValidator?.Display(result.Error) == true;
                _formError = shownOnFields ? null : result.Error.Message;
                return;
            }

            _done = true;
            StateHasChanged();
            await Task.Delay(1600);

            // Full page load: the old cookie is rejected on that request and the login page explains why.
            Navigation.NavigateTo("login?reason=password-changed", forceLoad: true);
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class PasswordFormModel
    {
        [Required(ErrorMessage = "Ingresa tu contraseña actual.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa la nueva contraseña.")]
        [StringLength(PasswordPolicy.MaxLength, MinimumLength = PasswordPolicy.MinLength,
            ErrorMessage = "La contraseña debe tener entre 8 y 128 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirma la nueva contraseña.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
